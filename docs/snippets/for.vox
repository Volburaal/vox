main {
    // The classic three-part loop.
    for (integer i <- 1; i <= 3; i++) {
        say "i = ", i;
    }

    // The same loop, spoken. Any of ; , : `while` `after iteration` separates the parts.
    for (integer j <- 1 while j is less or equal to 3 after iteration increment j) {
        say "j = ", j;
    }
}
