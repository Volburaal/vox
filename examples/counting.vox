// Counting, the way you would say it: range loops and in-place updates.
main {
    integer total <- 0;
    for i from 1 to 10 {
        add i to total;
    }
    say "1 to 10 adds up to ", total;

    say "countdown:";
    for i from 5 down to 1 {
        say i;
    }

    integer evens <- 0;
    for i from 0 until 20 step 2 {
        increment evens;
    }
    say "even numbers below 20: ", evens;

    integer n <- 7;
    double n;
    n squared -> n;
    halve the n;
    say "n is ", n;
}
