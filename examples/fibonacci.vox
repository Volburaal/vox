// Recursive fibonacci - exercises call frames and parameter binding.
integer fib(integer n) {
    if (n is less than 2) {
        return n;
    }
    return fib(n minus 1) + fib(n minus 2);
}

main {
    for (integer i <- 0 while i is less than 10 after iteration i + 1 -> i) {
        print(fib(i), " ");
    }
}
