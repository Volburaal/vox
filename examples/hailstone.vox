// Hailstone / Collatz sequence - the first example from the README.
integer hailstone(integer n) {

    while (n is greater than 1) {
        print(n);

        if ((n % 2) == 0) {
            n = n divided by 2;
        }
        else {
            n = n times 3 + 1;
        }
    }

    print(1);
    return n;
}

main {
    consider an integer start which is equal to 13;
    hailstone(start);
}
