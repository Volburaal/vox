// Hailstone / Collatz sequence - the first example from the README.
integer hailstone(integer n) {

    while (n is greater than 1) {
        say n;

        if (n remainder from 2 is 0) {
            n divided by 2 -> n;
        }
        else {
            n <- n times 3 plus 1;
        }
    }

    say 1;
    return n;
}

main {
    consider an integer start which is equal to some user input;
    hailstone(start);
}
