main {
    float f <- 3.9;
    print(f as integer, '\n');
    print((7 as float) / 2, '\n');
    print("42" as integer + 1, '\n');
    print("2.5" as float * 2, '\n');
    print(5 as string + "!", '\n');
    print(true as integer, '\n');
    print(0 as boolean, '\n');
    print("true" as boolean, '\n');
    print(3.0 as string, '\n');
    print(-7.9 as integer, '\n');
}
