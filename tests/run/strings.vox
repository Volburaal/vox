main {
    string greeting <- "hello";
    print(greeting + " " + "world", '\n');
    print("a" + 1, '\n');
    print("tab:\there", '\n');
    print("quote:\"q\"", '\n');
    print("back\\slash", '\n');
    print("newline:\nsecond", '\n');
    print("x", "y", "z", '\n');
    print("equal: ", greeting == "hello", '\n');
    print("less: ", "apple" < "banana", '\n');
}
