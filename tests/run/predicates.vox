main {
    integer n <- 12;
    print(n is even);
    print(n is odd);
    print(n is not even);
    print(n is divisible by 3);
    print(n is not divisible by 5);
    print(n is between 10 and 20);
    print(n is not between 1 and 5);
    print(-n is negative);
    print(0 is positive);
    print(0.5 is positive);
    print(2 + 1 is odd);
    string s <- "";
    print(s is empty);
    set s to "x";
    print(s is not empty);
    if (n is even and n is divisible by 4) {
        say "twelve works";
    }
}
