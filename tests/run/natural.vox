main {
    let there be a whole number a which is equal to 10;
    suppose an integer b which equals 4;
    print(a added to b, '\n');
    print(a minus b, '\n');
    print(a multiplied by b, '\n');
    print(a divided by b, '\n');
    print(b subtracted from a, '\n');
    print(a is greater than b, '\n');
    print(a
         is less than
         b, '\n');
    print(a to the power of 2, '\n');
    print(a remainder from 3, '\n');
}
