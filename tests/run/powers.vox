main {
    integer x <- 3;
    print(x ** 2);
    print(x squared);
    print(x cubed);
    print(2 raised to the power of 10);
    print(2 ** 3 ** 2);
    print(-x squared);
    print((-x) squared);
    print(x squared + x cubed);
    print(2 * x squared);
    print(x squared squared);
    print(1.5 squared);
    print(square root of x squared);
    integer y <- x ** 2 + 1;
    print(y);
}
