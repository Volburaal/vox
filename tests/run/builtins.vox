main {
    print(square root of 16, '\n');
    print(sqrt(2.25), '\n');
    print(absolute value of -7, '\n');
    print(abs(-2.5), '\n');
    print(round(2.5), '\n');
    print(round(2.4), '\n');
    print(floor of 3.7, '\n');
    print(ceiling of 3.2, '\n');
    print(min(3, 8), '\n');
    print(max(3.5, 2), '\n');
    print(length of "hello", '\n');
    print(length(""), '\n');
    print(uppercase of "vox", '\n');
    print(lowercase("LOUD"), '\n');
    integer n <- length of "abc" + 1;
    print(n, '\n');
}
